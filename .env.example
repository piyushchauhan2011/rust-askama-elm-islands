APP_ENV=development
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_local_only
POSTGRES_DB=hotel
DATABASE_URL=postgresql://hotel:hotel_local_only@localhost:5432/hotel
TEST_DATABASE_URL=postgresql://hotel:hotel_local_only@localhost:5432/hotel_test
SNAPSHOT_MODE=off
SNAPSHOT_INTERNAL_TOKEN=replace-with-a-random-64-character-hex-token-value
SNAPSHOT_API_ORIGIN=http://localhost:5000
PUBLIC_ORIGIN=http://localhost:5000
MEDIA_DIR=./data/media
SESSION_SECRET=development-session-secret-not-for-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ASSET_MODE=built
VITE_ORIGIN=http://localhost:5173
